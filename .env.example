# Personal Assistant (agentic) - local environment
# Copy to .env and fill in. Never commit the real .env.

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=
# Destination chat for proactive pushes (daily digest). Required by
# `python -m agent.digest`. Find it by messaging the bot and checking
# getUpdates, or with @userinfobot.
TELEGRAM_CHAT_ID=

# --- Anthropic / claude -p ---
# claude -p inherits ANTHROPIC_API_KEY from your keychain by default.
# Set here only for a project-scoped override.
# ANTHROPIC_API_KEY=

# --- Vault location ---
# The agent's Read/Glob/Grep/Write tools are scoped to this directory.
# Production: the same iCloud-backed Obsidian vault used by v1.
VAULT_ROOT="/Users/jasonchi/Library/Mobile Documents/iCloud~md~obsidian/Documents/Jason/PersonalAssistant"

# --- Logging ---
LOG_LEVEL=INFO
